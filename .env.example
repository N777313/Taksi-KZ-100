# Application
APP_NAME=taxi-kz
APP_ENV=development
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-random-secret

# PostgreSQL
POSTGRES_DB=taxi_kz
POSTGRES_USER=taxi_app
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Kafka: internal Docker network
KAFKA_PORT=9092
